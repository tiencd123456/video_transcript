# Sao chép file này thành .env (trong thư mục dự án, hoặc ~/.config/vtranscript/.env khi đã cài thành lệnh)
# rồi điền key. File .env nằm trong .gitignore, không lên git.
#
# Thứ tự ưu tiên: tham số dòng lệnh > biến đã export trong shell > hồ sơ (--profile) > .env > mặc định trong code.

# Key OpenRouter (https://openrouter.ai/settings/keys). Dán cả "sk-or-v1-..." hoặc chỉ phần sau đều được.
OPENROUTER_API_KEY=
# Chỉ cần khi chạy --llm-backend anthropic:
# ANTHROPIC_API_KEY=

# Model mặc định của máy này. Để trống dòng nào thì dòng đó lấy mặc định trong code (giống hồ sơ best).
# Muốn thử bộ model khác cho một lần chạy thì dùng --profile budget / cheap / <hồ sơ tự tạo trong ./profiles/>.
VT_ASR_BACKEND=api                               # api | local
VT_ASR_MODEL=elevenlabs/scribe-v2                # nhận dạng giọng nói
VT_LLM_BACKEND=openrouter                        # openrouter | claude-cli | anthropic
VT_LLM_VISION_MODEL=anthropic/claude-sonnet-5.5  # đọc chữ trên khung hình
VT_LLM_STRONG_MODEL=anthropic/claude-opus-5.5    # lập từ điển tên riêng, thuật ngữ
VT_LLM_MODEL=deepseek/deepseek-v4.1-flash        # sửa từng cụm, soát toàn cục, tóm tắt
